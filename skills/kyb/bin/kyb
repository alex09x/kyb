#!/usr/bin/env bash
# Copyright (c) 2026 Alexander Panasenko
# Contact: alex@prod.codes
# Author: https://prod.codes/about/
# Project: https://github.com/alex09x/kyb
# SPDX-License-Identifier: MIT
# kyb — CLI for Know Your Business: our shared infrastructure knowledge base.
# The service runs in docker on the shared server; every agent and machine sees the same data.
# A shell trace would print the access token (it is expanded where it is read and
# where it is handed to curl), so tracing is switched off for the whole run.
case "$-" in *x*) set +x; echo "kyb: shell tracing is off inside kyb - it would print the access token" >&2 ;; esac
set -euo pipefail

# Server address, in priority order: env KYB_HOST/KYB_ADDR -> the host file
# written by the installer (~/.config/kyb/host) -> localhost.
KYB_HOST="${KYB_HOST:-$(cat "$HOME/.config/kyb/host" 2>/dev/null || true)}"
KYB_HOST="${KYB_HOST:-127.0.0.1}"
ADDR="${KYB_ADDR:-$KYB_HOST:9310}"
# KYB_URL names the server whole, scheme included - the way to reach one behind
# TLS (https://kyb.example). A token sent over plain http can be read and reused
# by anyone who can watch the network; http is for a network you trust.
if [ -n "${KYB_URL:-}" ]; then
  BASE="${KYB_URL%/}"
  ADDR="${BASE#*://}"
else
  BASE="http://$ADDR"
fi

# Access token, in priority order: env KYB_TOKEN -> ~/.config/kyb/token (written
# by `kyb login`). A server that does not ask for tokens ignores it. The token is
# handed to curl through a config stream, never as an argument: the command line
# of a process is readable by every user of the machine.
KYB_TOKEN="${KYB_TOKEN:-$(cat "$HOME/.config/kyb/token" 2>/dev/null || true)}"

die() { echo "kyb: $*" >&2; exit 1; }

# A server older than this CLI cannot object to a parameter it has never heard
# of: it ignores the unknown name and answers the question it DID understand. Ask
# about the past and you get today's data with a 200, which is indistinguishable
# from "nothing changed". The server cannot fix that - only a client that checks
# before asking can, so this refuses to send a version-dependent flag to a server
# that does not advertise the capability.
#
# FAIL-CLOSED, as a decision rather than a side effect of how the errors happen to
# be handled. Every way the check itself can fail - host unreachable, timeout, a
# proxy answering instead, an unreadable body - refuses the command. Fail-open
# would restore the original bug in full and add a false sense of safety on top,
# because a check that silently passes is worse than no check: nobody looks again.
#
# The cost is that a network hiccup breaks --as-of against a perfectly good
# server, so the messages separate the two causes. "I could not ask" is usually
# transient and worth retrying; "this server cannot" is not, and needs an upgrade
# or a different command.
require_capability() { # require_capability <capability> <flag> <what goes wrong without it>
  local want="$1" flag="$2" why="$3" health
  health="$(curl -sS -m 10 "$BASE/healthz" 2>/dev/null)" || die \
    "could not ask $ADDR whether it supports $flag, so $flag was NOT sent.
     This is usually transient — retry, or check what is listening on $ADDR."
  CAP_WANT="$want" CAP_FLAG="$flag" CAP_WHY="$why" CAP_ADDR="$ADDR" CAP_HEALTH="$health" python3 - <<'PY' || exit 1
import json, os, sys

want = os.environ["CAP_WANT"]
flag = os.environ["CAP_FLAG"]
why = os.environ["CAP_WHY"]
raw = os.environ["CAP_HEALTH"]

def refuse(*lines):
    for line in lines:
        print("kyb: " + line, file=sys.stderr)
    raise SystemExit(1)

try:
    health = json.loads(raw)
except json.JSONDecodeError:
    refuse("could not read the capabilities of " + os.environ["CAP_ADDR"] + ", so "
           + flag + " was NOT sent.",
           "/healthz did not answer with JSON - a proxy or an error page may be",
           "answering instead of the server. Usually transient; retry.")

caps = health.get("capabilities")
if caps is None:
    refuse("this server does not report capabilities, so it predates " + flag + ".",
           why,
           "Upgrade the server, or drop " + flag + ".")
if want not in caps:
    refuse("server " + str(health.get("version", "unknown")) + " does not support "
           + flag + " (it reports: " + (", ".join(caps) or "none") + ").",
           why)
PY
}

pretty() {
  local in
  in="$(cat)"
  [ -n "$in" ] || return 0
  if command -v jq >/dev/null 2>&1; then printf '%s\n' "$in" | jq .; else printf '%s\n' "$in"; fi
}

# The deadline block that rides on every read answer, as a few lines for a
# person or an agent to notice. It goes to stderr: stdout stays exactly what the
# server sent, so a script that parses it sees no difference.
BANNER_PY='
import json, sys
try:
    block = json.load(sys.stdin).get("deadlines")
except Exception:
    raise SystemExit(0)
if not isinstance(block, dict) or not block.get("count"):
    raise SystemExit(0)

def when(i):
    d = i["days_left"]
    if i["overdue"]:
        return "%dd late" % -d if d < 0 else "late today"
    return "due today" if d == 0 else "in %dd" % d

late = block.get("overdue", 0)
soon = block["count"] - late
said = [s for s in ("%d overdue" % late if late else "", "%d due soon" % soon if soon else "") if s]
print("kyb deadlines, today %s: %s" % (block.get("today"), ", ".join(said)))
for i in block.get("items", []):
    note = "due " + i["due"]
    if i.get("provisional"):
        note = "expected " + i["due"] + (", waits on " + i["waits_on"] if i.get("waits_on") else "")
    line = "  %-10s %s%s  %s  (%s)" % (when(i), "HARD " if i.get("hard") else "", i["key"], i["title"], note)
    print(line if len(line) <= 160 else line[:159] + "\u2026")
if block.get("more"):
    print("  +%d more: kyb deadlines" % block["more"])
'

# A read answer: the JSON to stdout, its deadline block as a banner to stderr.
show() {
  local out
  out="$(cat)"
  [ -n "$out" ] || return 0
  [ -n "$NO_DEADLINES" ] || printf '%s' "$out" | python3 -c "$BANNER_PY" >&2 || true
  printf '%s\n' "$out" | pretty
}

# With --no-deadlines the server is asked to leave the block off (DL is the
# query parameter to append). Asking an older server would be refused outright:
# it knows no such parameter - and sends no block either.
deadlines_param() {
  DL=""
  [ -n "$NO_DEADLINES" ] || return 0
  require_capability deadlines "--no-deadlines" "That server sends no deadline block at all, so the flag is not needed there; drop it."
  DL="&deadlines=false"
}

# The deadline flags of `task` and `task-status`, as a JSON object of only the
# flags that were passed: a flag left out keeps what the task already says.
# Reads the dl_* variables the two commands' flag loops set.
deadline_json() {
  DL_DUE="$dl_due" DL_DUE_SET="$dl_due_set" DL_HARD="$dl_hard" \
  DL_REMIND="$dl_remind" DL_REMIND_SET="$dl_remind_set" \
  DL_WAITS="$dl_waits" DL_WAITS_SET="$dl_waits_set" \
  DL_EXPECTED="$dl_expected" DL_EXPECTED_SET="$dl_expected_set" python3 -c '
import json, os, sys
e, p = os.environ, {}
if e["DL_DUE_SET"]:
    p["due"] = e["DL_DUE"]
if e["DL_HARD"]:
    p["hard"] = e["DL_HARD"] == "true"
if e["DL_REMIND_SET"]:
    days = e["DL_REMIND"].strip()
    if days == "":
        p["remind_days"] = None
    elif days.isdigit():
        p["remind_days"] = int(days)
    else:
        sys.exit("kyb: --remind-days takes a whole number of days (\"\" returns it to the default)")
if e["DL_WAITS_SET"]:
    p["waits_on"] = e["DL_WAITS"]
if e["DL_EXPECTED_SET"]:
    p["expected"] = e["DL_EXPECTED"]
print(json.dumps(p))'
}
dl_reset() {
  dl_due=""; dl_due_set=""; dl_hard=""; dl_remind=""; dl_remind_set=""
  dl_waits=""; dl_waits_set=""; dl_expected=""; dl_expected_set=""
}
# An older server ignores fields it does not know: the deadline would be
# dropped without a word. So a deadline flag is only sent to one that has them.
require_deadlines_if_set() {
  [ -n "$dl_due_set$dl_hard$dl_remind_set$dl_waits_set$dl_expected_set" ] || return 0
  require_capability deadlines "the deadline flags" "An older server ignores fields it does not know, so the deadline would be silently dropped."
}

urlenc() { python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${1:-}"; }

# Who is writing, for the record: the agent, its session and the workspace,
# read from the environment the agent runs the CLI in. The server writes them
# as trailers on the commit (kyb history shows them as `by`); they are not an
# identity and grant nothing - a token does that. Overrides: KYB_AGENT,
# KYB_SESSION, KYB_WORKSPACE. The workspace is a name and a path inside the
# repository, never an absolute path: machines and home directories stay out
# of the shared history.
# The agent and its session are decided together: first which agent this is,
# then that agent's own session variable and no other's. When one agent runs
# inside another's terminal, the process tree walk discovers the inner agent
# (the nearest agent ancestor) and records that agent and its own session,
# instead of relying solely on inherited environment variables. Outer agents
# are recorded as nested-in. When no agent ancestor is found in the process
# tree, the environment variables serve as a fallback. KYB_AGENT still overrides
# all discovery.
# Which agent a process is, judged by its program alone: a path inside an
# agent's app bundle, or the program's name - or, for an interpreter (node,
# python, ...), the script it runs, which is the only case that costs a second
# ps. Shells are not interpreters here: every agent runs its tools as
# `zsh -c "..."`, and a command line that mentions an agent is not one. Sets
# AGENT_OF. No subshells beyond ps itself: this runs for every ancestor on every
# kyb call, and on a Mac with a thousand processes a whole-table snapshot costs
# ten times a ps per ancestor.
agent_of() { # agent_of <pid> <comm> <ps_cmd>
  local pid="$1" prog="$2" ps_cmd="$3" w
  local -a words
  AGENT_OF=""
  # Claude Code exports CLAUDE_PID as an extra signal (it must be an ancestor to count)
  if [ -n "${CLAUDE_PID:-}" ] && [ "$pid" = "$CLAUDE_PID" ]; then AGENT_OF=claude; return 0; fi
  case "${prog##*/}" in
    node|python|python3|bun|deno)
      prog=""
      read -r -a words <<< "$("$ps_cmd" -o args= -p "$pid" 2>/dev/null || true)"
      for w in ${words[@]+"${words[@]:1}"}; do
        case "$w" in -*) continue ;; esac
        prog="$w"
        break
      done ;;
  esac
  case "$prog" in
    *[Aa]ntigravity.app/*)       AGENT_OF=antigravity ;;
    *[Cc]odex[Cc][Ll][Ii].app/*) AGENT_OF=codex ;;
    *)
      case "${prog##*/}" in
        claude|claude.js)    AGENT_OF=claude ;;
        codex|codex.js)      AGENT_OF=codex ;;
        [Aa]ntigravity*|agy) AGENT_OF=antigravity ;;
      esac ;;
  esac
  return 0
}

# Walk up from the CLI's parent to the nearest agent (the inner one) and the
# agent it runs inside, if any.
walk_agent_ancestors() {
  # KYB_PS_COMMAND: test-only hook to substitute ps with a mock command
  local ps_cmd="${KYB_PS_COMMAND:-ps}"
  # KYB_TEST_PPID: test-only hook to seed the initial parent PID
  local pid="${KYB_TEST_PPID:-$PPID}" level=0 line ppid comm
  PROC_INNER_AGENT=""
  PROC_OUTER_AGENT=""
  while [ "$level" -lt 30 ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    level=$((level + 1))
    line="$("$ps_cmd" -o ppid= -o comm= -p "$pid" 2>/dev/null)" || break
    read -r ppid comm <<< "$line"
    case "$ppid" in ''|*[!0-9]*) break ;; esac
    agent_of "$pid" "$comm" "$ps_cmd"
    if [ -n "$AGENT_OF" ]; then
      if [ -z "$PROC_INNER_AGENT" ]; then
        PROC_INNER_AGENT="$AGENT_OF"
      elif [ "$AGENT_OF" != "$PROC_INNER_AGENT" ]; then
        PROC_OUTER_AGENT="$AGENT_OF"
        break
      fi
    fi
    [ "$ppid" != "$pid" ] || break
    pid="$ppid"
  done
}

by_context() { # sets BY_AGENT, BY_SESSION, and optionally BY_NESTED_IN
  local from_prod=""
  BY_AGENT="${KYB_AGENT:-}"
  BY_NESTED_IN=""
  if [ -z "$BY_AGENT" ]; then
    local PROC_INNER_AGENT="" PROC_OUTER_AGENT=""
    walk_agent_ancestors
    if [ -n "$PROC_INNER_AGENT" ]; then
      BY_AGENT="$PROC_INNER_AGENT"
      BY_NESTED_IN="$PROC_OUTER_AGENT"
    fi
  fi
  if [ -z "$BY_AGENT" ]; then
    if [ -n "${CODEX_THREAD_ID:-}${CODEX_SESSION_ID:-}" ]; then BY_AGENT=codex
    elif [ -n "${ANTIGRAVITY_CONVERSATION_ID:-}${ANTIGRAVITY_AGENT:-}" ]; then BY_AGENT=antigravity
    elif [ -n "${CLAUDECODE:-}${CLAUDE_CODE_SESSION_ID:-}" ]; then BY_AGENT=claude
    elif [ -n "${PROD_PROVIDER:-}" ]; then BY_AGENT="$PROD_PROVIDER"; from_prod=1
    else BY_AGENT=shell
    fi
  fi
  # the session is the agent's own, or nothing: prod's session key belongs to the
  # agent only when prod also named that agent, never to one named by hand
  case "$BY_AGENT" in
    codex)       BY_SESSION="${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}" ;;
    antigravity) BY_SESSION="${ANTIGRAVITY_CONVERSATION_ID:-}" ;;
    claude)      BY_SESSION="${CLAUDE_CODE_SESSION_ID:-}" ;;
    *)           BY_SESSION=""; [ -n "$from_prod" ] && BY_SESSION="${PROD_PRIMARY_SESSION_KEY:-}" ;;
  esac
  BY_SESSION="${KYB_SESSION:-$BY_SESSION}"
}
# The repository's name and the path inside it; never an absolute path. Both ends
# are the physical paths and the directory must really be inside the repository:
# a symlinked working directory must not turn into the whole path from /.
by_workspace() {
  if [ -n "${KYB_WORKSPACE:-}" ]; then
    case "$KYB_WORKSPACE" in /*) basename "$KYB_WORKSPACE" ;; *) printf '%s' "$KYB_WORKSPACE" ;; esac
    return
  fi
  local top here
  here="$(pwd -P)"
  if top="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -n "$top" ]; then
    top="$(cd "$top" && pwd -P)"
    if [ "$here" = "$top" ]; then basename "$top"
    else
      case "$here" in "$top"/*) printf '%s/%s' "$(basename "$top")" "${here#"$top"/}" ;; *) basename "$top" ;; esac
    fi
  elif [ -n "${PROD_WORKSPACE_NAME:-}" ]; then
    printf '%s' "$PROD_WORKSPACE_NAME"
  else
    basename "$here"
  fi
}
# One curl config line `header = "<name>: <value>"`. The value goes through the
# config file's quoted-string syntax, so a quote or a backslash in it is escaped
# and control characters are dropped: a value can never end the line and start
# another option, which is what would send the headers - token included - to a
# URL of its choosing.
cfg_header() { # cfg_header <name> <value>
  local v
  v="$(printf '%s' "$2" | tr -d '\000-\037\177')"
  v="${v//\\/\\\\}"; v="${v//\"/\\\"}"
  printf 'header = "%s: %s"\n' "$1" "$v"
}
# curl config lines: every header the server reads, token included, in a file
# descriptor rather than on the command line, where `ps` could show them
request_headers() {
  by_context
  [ -n "$KYB_TOKEN" ] && cfg_header authorization "Bearer $KYB_TOKEN"
  cfg_header x-kyb-agent "$BY_AGENT"
  cfg_header x-kyb-session "$BY_SESSION"
  [ -n "${BY_NESTED_IN:-}" ] && cfg_header x-kyb-nested-in "$BY_NESTED_IN"
  cfg_header x-kyb-workspace "$(by_workspace)"
  cfg_header x-kyb-via cli
  # "today" for the deadline block is the caller's calendar day, not the
  # server's: a task due on the 14th is not late at 19:00 on the 14th here,
  # whatever date the server's clock has reached
  cfg_header x-kyb-today "${KYB_TODAY:-$(date +%F)}"
}

# This is a pure HTTP client for the kyb server — no ssh, no attempts to
# start or fix anything remotely. If the server doesn't answer, say so and stop.
# Exit codes: 0 success, 1 server rejected (4xx), 2 server error (5xx), 3 cannot reach server.
_kyb_curl() {
  local fail_on_error="$1"
  shift
  local out_file err_file rc=0 http_code
  out_file="$(mktemp -t kyb-out.XXXXXX)"
  err_file="$(mktemp -t kyb-err.XXXXXX)"
  http_code="$(curl -sS -m 15 --config <(request_headers) -o "$out_file" -w "%{http_code}" "$@" 2>"$err_file")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    local err
    err="$(cat "$err_file" 2>/dev/null || true)"
    rm -f "$out_file" "$err_file"
    echo "kyb: cannot reach $ADDR: $err" >&2
    exit 3
  fi
  rm -f "$err_file"
  local body
  body="$(cat "$out_file" 2>/dev/null || true)"
  rm -f "$out_file"
  if [ "$fail_on_error" -eq 1 ]; then
    if [ "$http_code" -ge 400 ] && [ "$http_code" -le 499 ]; then
      [ -n "$body" ] && printf '%s\n' "$body" >&2
      exit 1
    elif [ "$http_code" -ge 500 ] && [ "$http_code" -le 599 ]; then
      [ -n "$body" ] && printf '%s\n' "$body" >&2
      exit 2
    fi
  fi
  [ -n "$body" ] && printf '%s\n' "$body"
  if [ "$http_code" -ge 400 ] && [ "$http_code" -le 499 ]; then
    return 1
  elif [ "$http_code" -ge 500 ] && [ "$http_code" -le 599 ]; then
    return 2
  fi
  return 0
}

kyb_curl() {
  _kyb_curl 1 "$@"
}

kyb_curl_raw() {
  _kyb_curl 0 "$@"
}

usage() {
  local status="${1:-1}"
  cat >&2 <<'EOF'
kyb — Know Your Business (our infrastructure knowledge base)
  kyb query "text" [--tag a,b] [--history] [--as-of DATE|SHA] [--changed-between A,B] [--recent] [--limit N]
            [--kind knowledge|incident|task] [--status S] [--service X]
            [--priority P] [--assignee A] [--parent task-<slug>]
  kyb tags                                          (which topics the base covers)
  kyb add --key <slug> --title "..." [--tags a,b] [--refs r1,r2]   (body on stdin)
  kyb get <key> [--at <sha>]
  kyb deadlines [--within 30d] [--overdue] [--hard] [--tag a,b] [--assignee A] [--json]
                                                    (open tasks with a due date: overdue / this week / later)
  kyb history <key>
  kyb export [--at <sha>] [--out FILE] [--page N]   (every key as of one commit as JSON lines:
                                                    active, archived, retracted; checks completeness)
  kyb diff <key> [--from REV] [--to REV]
  kyb rm <key>
  kyb reindex
  kyb health
  kyb whoami                                        (who the server takes you for, and your role)
  kyb login                                         (token on stdin; kept in ~/.config/kyb/token, owner-only)
  kyb logout

incident reports (key must start with inc-, e.g. inc-2026-07-22-orders-api-oom):
  kyb incident --template                       (print the body skeleton to fill in)
  kyb incident --key inc-<date>-<slug> --title "..." --service <svc> --severity low|medium|high|critical
               [--hosts a,b] [--status open|mitigated|resolved] [--knowledge key1,key2]
               [--detection "cmd + expected healthy result"]
               [--affected '[{"scope":"okx","from":"...Z","to":"...Z"}]']   (JSON array)
               [--started <rfc3339>] [--detected <rfc3339>]
               [--resolution "..."] [--tags a,b] [--refs r1,r2]    (body on stdin)
  kyb incidents [--status S] [--service X] [--open-followups] [--all] [--limit N]
               (live reports only, open first, freshest on top; --all adds archived closed ones,
                an explicit --status also looks into the archive)
  kyb resolve <key> [--status mitigated] [--resolution "how it ended"]
               (no --resolution: the closing comment is read from stdin)

tasks and ideas (key must start with task-, e.g. task-raise-log-retention):
  kyb task --key task-<slug> --title "..." [--status open|in_progress|blocked|done|dropped]
           [--priority low|medium|high|critical] [--blocked-reason "what it waits on"]
           [--assignee <label>] [--parent task-<slug>]
           [--knowledge key1,key2] [--resolution "..."] [--tags a,b] [--refs r1,r2]
           [--due DATE] [--hard] [--remind-days N] [--waits-on "event"] [--expected DATE]   (body on stdin)
           (--blocked-reason only with --status blocked; done/dropped close and archive)
  kyb task-status <key> [--status open|in_progress|blocked]
           [--assignee <label>] [--parent task-<slug>] [--blocked-reason "what it waits on"]
           [--due DATE] [--hard|--no-hard] [--remind-days N] [--waits-on "event"] [--expected DATE]
           (partial update: title, body, tags, priority and links stay as stored —
            nothing to resend. Leaving blocked clears the reason; --assignee "" hands
            the task back. Closing is `kyb done`, not this.)
  kyb tasks [--status S] [--priority P] [--assignee A] [--parent task-<slug>]
           [--open-followups] [--all] [--limit N]
           (live tasks only — open, in_progress, blocked — freshest on top;
            --all adds archived closed ones)
  kyb done <key> [--status dropped] [--resolution "what came of it"]
           (no --resolution: the closing comment is read from stdin)

deadlines on tasks (task and task-status take the same flags):
  --due YYYY-MM-DD|<date-time with zone>   when it is due ("" clears it)
  --hard | --no-hard                       a miss has real consequences (expiry, contract, regulator)
  --remind-days N                          surface it N days ahead (default 14, hard 30; "" = default)
  --waits-on "event" --expected DATE       the date depends on an event: remind on the expected one
  A flag left out keeps what the task already says. Moving a due date is a new version.

Every read (query, get, tasks, incidents) prints the overdue and nearly due tasks
as a short banner on stderr; --no-deadlines leaves it off.

Closing an incident or a task archives it: the file leaves the canon, the
report stays searchable (kyb query) and readable (kyb get) forever.

exit codes:
  0  success
  1  the server rejected the request (4xx), or malformed command line
  2  server error (5xx)
  3  the server could not be reached
EOF
  exit "$status"
}

# --no-deadlines works on every command, wherever it is written
NO_DEADLINES=""
argv=()
for a in "$@"; do
  if [ "$a" = "--no-deadlines" ]; then NO_DEADLINES=1; else argv+=("$a"); fi
done
set -- ${argv[@]+"${argv[@]}"}

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  --help|-h)
    usage 0
    ;;
  query|q)
    text="${1:-}"; [ $# -gt 0 ] && shift || true
    tag=""; history="false"; as_of=""; changed=""; limit="10"; sort=""; kind=""; status=""; service=""
    priority=""; assignee=""; parent=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --tag|--tags) tag="$2"; shift 2 ;;
        --history) history="true"; shift ;;
        --as-of) as_of="${2:-}"; shift 2 ;;
        --changed-between) changed="${2:-}"; shift 2 ;;
        --limit) limit="$2"; shift 2 ;;
        --recent) sort="recent"; shift ;;
        --kind) kind="$2"; shift 2 ;;
        --status) status="$2"; shift 2 ;;
        --service) service="$2"; shift 2 ;;
        --priority) priority="$2"; shift 2 ;;
        --assignee) assignee="$2"; shift 2 ;;
        --parent|--parent-task) parent="$2"; shift 2 ;;
        *) die "query: unknown flag $1" ;;
      esac
    done
    [ -z "$as_of" ]  || require_capability as_of "--as-of" "An older server ignores a parameter it does not know and answers as if it were absent, so you would get CURRENT data as the answer to a question about the past."
    [ -z "$changed" ] || require_capability changed_between "--changed-between" "An older server ignores a parameter it does not know and answers as if it were absent, so you would get CURRENT data as the answer to a question about the past."
    deadlines_param
    kyb_curl "$BASE/search?q=$(urlenc "$text")&tag=$(urlenc "$tag")&history=$history&as_of=$(urlenc "$as_of")&changed_between=$(urlenc "$changed")&limit=$limit&sort=$sort&kind=$(urlenc "$kind")&status=$(urlenc "$status")&service=$(urlenc "$service")&priority=$(urlenc "$priority")&assignee=$(urlenc "$assignee")&parent_task=$(urlenc "$parent")$DL" | show
    ;;
  tags)
    kyb_curl "$BASE/tags" | pretty
    ;;
  add)
    key=""; title=""; tags=""; refs=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --key) key="$2"; shift 2 ;;
        --title) title="$2"; shift 2 ;;
        --tags) tags="$2"; shift 2 ;;
        --refs) refs="$2"; shift 2 ;;
        *) die "add: unknown flag $1" ;;
      esac
