    kyb_curl "$BASE/tasks?status=$(urlenc "$status")&priority=$(urlenc "$priority")&assignee=$(urlenc "$assignee")&parent_task=$(urlenc "$parent")&followups=$followups&all=$all&limit=$limit$DL" | show
    ;;
  done)
    key="${1:-}"; [ -n "$key" ] || usage; shift || true
    status="done"; resolution=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status="$2"; shift 2 ;;
        --resolution) resolution="$2"; shift 2 ;;
        *) die "done: unknown flag $1" ;;
      esac
    done
    # no --resolution: read the closing comment from stdin (required to close)
    if [ -z "$resolution" ] && ! [ -t 0 ]; then resolution="$(cat)"; fi
    payload="$(RESOLUTION="$resolution" python3 -c '
import json, os, sys
print(json.dumps({"status": sys.argv[1], "resolution": os.environ["RESOLUTION"]}))' "$status")"
    kyb_curl -X POST "$BASE/tasks/$key/resolve" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  get)
    key="${1:-}"; [ -n "$key" ] || usage; shift || true
    at=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --at) at="$2"; shift 2 ;;
        *) die "get: unknown flag $1" ;;
      esac
    done
    deadlines_param
    q=""; [ -n "$at" ] && q="&at=$(urlenc "$at")"
    q="$q$DL"; [ -n "$q" ] && q="?${q#&}"
    kyb_curl "$BASE/knowledge/$key$q" | show
    ;;
  deadlines)
    within=""; overdue=""; hard=""; tag=""; assignee=""; as_json=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --within) within="$2"; shift 2 ;;
        --overdue) overdue="true"; shift ;;
        --hard) hard="true"; shift ;;
        --tag|--tags) tag="$2"; shift 2 ;;
        --assignee) assignee="$2"; shift 2 ;;
        --json) as_json=1; shift ;;
        *) die "deadlines: unknown flag $1" ;;
      esac
    done
    require_capability deadlines "kyb deadlines" "An older server has no such route and would simply answer 404."
    out="$(kyb_curl "$BASE/deadlines?within=$(urlenc "$within")&overdue=$overdue&hard=$hard&tag=$(urlenc "$tag")&assignee=$(urlenc "$assignee")")"
    if [ -n "$as_json" ]; then printf '%s\n' "$out" | pretty; exit 0; fi
    printf '%s' "$out" | python3 -c '
import json, sys
answer = json.load(sys.stdin)
if "deadlines" not in answer:
    print(json.dumps(answer, indent=2), file=sys.stderr)
    raise SystemExit(1)
rows = answer["deadlines"]
print("deadlines, today %s: %d open task%s with a date" % (answer["today"], len(rows), "" if len(rows) == 1 else "s"))
titles = {"overdue": "OVERDUE", "this_week": "THIS WEEK (next 7 days)", "later": "LATER"}
for bucket in ("overdue", "this_week", "later"):
    group = [r for r in rows if r["bucket"] == bucket]
    if not group:
        continue
    print(titles[bucket])
    for r in group:
        d = r["days_left"]
        if r["overdue"]:
            when = "%dd late" % -d if d < 0 else "late today"
        else:
            when = "due today" if d == 0 else "in %dd" % d
        note = ("expected " if r.get("provisional") else "due ") + r["due"]
        if r.get("provisional") and r.get("waits_on"):
            note += ", waits on " + r["waits_on"]
        if r.get("assignee"):
            note += ", " + r["assignee"]
        print("  %-10s %s%s  %s  (%s)" % (when, "HARD " if r.get("hard") else "", r["key"], r["title"], note))
'
    ;;
  diff)
    key="${1:-}"; shift || true
    [ -n "$key" ] || die "diff: <key> required"
    from=""; to=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --from) from="${2:-}"; shift 2 ;;
        --to) to="${2:-}"; shift 2 ;;
        *) die "diff: unknown option $1" ;;
      esac
    done
    require_capability diff "kyb diff" "An older server has no such route and would simply answer 404."
    kyb_curl "$BASE/knowledge/$key/diff?from=$(urlenc "$from")&to=$(urlenc "$to")" | pretty
    ;;

  export)
    # Every key of the base as of one commit, as JSON lines, read in pages that
    # all name that commit - so writes made meanwhile change nothing in it. The
    # check at the end is the point: one key per line, none twice, the per-state
    # counts the server announced, and a last page that says it is the last.
    at=""; out=""; page=200
    while [ $# -gt 0 ]; do
      case "$1" in
        --at) at="${2:-}"; shift 2 ;;
        --out) out="${2:-}"; shift 2 ;;
        --page) page="${2:-}"; shift 2 ;;
        *) die "export: unknown option $1" ;;
      esac
    done
    case "$page" in ''|*[!0-9]*|0) die "export: --page takes a positive number" ;; esac
    require_capability export "kyb export" "An older server has no such route and would simply answer 404."
    pages="$(mktemp -d "${TMPDIR:-/tmp}/kyb-export.XXXXXX")"
    trap 'rm -rf "$pages"' EXIT
    after=""; snap=""; n=0
    while :; do
      n=$((n + 1))
      file="$pages/$(printf '%06d' "$n").jsonl"
      url="$BASE/export?limit=$page"
      [ -n "$at" ] && url="$url&at=$(urlenc "$at")"
      [ -n "$after" ] && url="$url&after=$(urlenc "$after")"
      kyb_curl "$url" > "$file"
      # the first page fixes the snapshot; every later one asks for it by sha.
      # Each page is checked before the next is asked for: the same snapshot, keys
      # after the cursor and in order, and a cursor that is this page's last key -
      # so a server that ignored the cursor fails here instead of looping forever.
      next="$(python3 - "$file" "$snap" "$after" <<'PY'
import json, sys
path, snap, prev = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(path, encoding="utf-8").read().splitlines()
def fail(msg):
    print("kyb: export: " + msg, file=sys.stderr)
    raise SystemExit(1)
try:
    rows = [json.loads(l) for l in lines]
except json.JSONDecodeError:
    rows = []
if len(rows) < 2 or rows[0].get("type") != "snapshot" or rows[-1].get("type") != "end":
    fail("the server did not answer with an export page: " + " ".join(lines)[:300])
head, end = rows[0], rows[-1]
keys = [r["key"] for r in rows[1:-1]]
if snap and head["snapshot"] != snap:
    fail(f"page names snapshot {head['snapshot']}, the export is reading {snap}")
if end["snapshot"] != head["snapshot"]:
    fail("a page whose end names another snapshot than its start")
if keys != sorted(set(keys)) or (prev and keys and keys[0] <= prev):
    fail(f"keys of a page are not strictly after the cursor '{prev}' and in order")
nxt = end["next_after"] or ""
if end["complete"] != (nxt == ""):
    fail("a page that is complete and also names a next cursor, or neither")
if nxt and (not keys or nxt != keys[-1]):
    fail(f"the cursor '{nxt}' is not the last key of its page: no progress")
print((head["snapshot"] or "-") + " " + nxt)
PY
)" || exit 1
      read -r snap after <<< "$next"
      [ "$snap" = "-" ] && snap=""
      at="$snap"
      [ -n "$after" ] || break
    done
    python3 - "$pages" "${out:--}" <<'PY'
import json, os, sys
from collections import Counter
pages, out = sys.argv[1], sys.argv[2]
heads, ends, entries = [], [], []
for name in sorted(os.listdir(pages)):
    for line in open(os.path.join(pages, name), encoding="utf-8"):
        row = json.loads(line)
        {"snapshot": heads, "end": ends, "entry": entries}[row["type"]].append(row)
problems = []
snaps = {h["snapshot"] for h in heads} | {e["snapshot"] for e in ends}
if len(snaps) != 1:
    problems.append(f"pages name {len(snaps)} different snapshots")
keys = [e["key"] for e in entries]
if len(set(keys)) != len(keys):
    problems.append(f"{len(keys) - len(set(keys))} keys repeated")
if keys != sorted(keys):
    problems.append("keys are out of order")
counts = Counter((e["kind"], e["state"]) for e in entries)
announced = Counter({(k, s): n for k, by in heads[0]["counts"].items() for s, n in by.items()})
if counts != announced:
    problems.append(f"counts {dict(counts)} differ from the announced {dict(announced)}")
if len(entries) != heads[0]["total"]:
    problems.append(f"{len(entries)} entries, the snapshot has {heads[0]['total']}")
if not ends[-1]["complete"]:
    problems.append("the last page does not say it is complete")
sink = sys.stdout if out == "-" else open(out, "w", encoding="utf-8")
for e in entries:
    sink.write(json.dumps(e, ensure_ascii=False) + "\n")
summary = {
    "snapshot": heads[0]["snapshot"], "committed_at": heads[0].get("committed_at"),
    "pages": len(heads), "entries": len(entries), "unique_keys": len(set(keys)),
    "counts": heads[0]["counts"], "complete": not problems, "problems": problems,
}
print(json.dumps(summary, indent=2), file=sys.stderr if out == "-" else sys.stdout)
raise SystemExit(1 if problems else 0)
PY
    ;;
  history)
    key="${1:-}"; [ -n "$key" ] || usage
    kyb_curl "$BASE/knowledge/$key/history" | pretty
    ;;
  rm|delete)
    key="${1:-}"; [ -n "$key" ] || usage
    kyb_curl -X DELETE "$BASE/knowledge/$key" | pretty
    ;;
  reindex)
    kyb_curl -X POST "$BASE/reindex" | pretty
    ;;
  health)
    kyb_curl "$BASE/healthz" | pretty
    ;;
  whoami)
    # the server's answer carries `by`: what it would record for a write from here
    kyb_curl "$BASE/whoami" | pretty
    ;;
  login)
    # The token comes on stdin so it is never in the shell history or the process list.
    IFS= read -r token || true
    token="${token//[[:space:]]/}"
    [ -n "$token" ] || die "no token on stdin: echo it in, or paste it and press Enter"
    KYB_TOKEN="$token"
    rc=0
    who="$(kyb_curl_raw "$BASE/whoami")" || rc=$?
    [ "$rc" -ne 3 ] || exit 3
    case "$who" in
      *'"actor":{'*) ;;
      *'"auth":"off"'*) die "this server does not ask for tokens; nothing was saved" ;;
      *) die "the server does not know this token; nothing was saved" ;;
    esac
    mkdir -p "$HOME/.config/kyb"
    ( umask 077; printf '%s\n' "$token" > "$HOME/.config/kyb/token" )
    printf '%s\n' "$who" | pretty
    ;;
  logout)
    rm -f "$HOME/.config/kyb/token"
    echo "token forgotten"
    ;;
  *)
    usage
    ;;
esac
