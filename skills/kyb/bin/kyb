        --priority) priority="$2"; shift 2 ;;
        --blocked-reason) blocked_reason="$2"; shift 2 ;;
        --assignee) assignee="$2"; shift 2 ;;
        --parent|--parent-task) parent="$2"; shift 2 ;;
        --knowledge) knowledge="$2"; shift 2 ;;
        --resolution) resolution="$2"; shift 2 ;;
        --tags) tags="$2"; tags_set=1; shift 2 ;;
        --refs) refs="$2"; shift 2 ;;
        *) die "task: unknown flag $1" ;;
      esac
    done
    [ -n "$key" ] && [ -n "$title" ] || die "task: --key and --title are required (body comes from stdin)"
    deadline="$(deadline_json)"
    require_deadlines_if_set
    body="$(cat)"
    payload="$(BODY="$body" RESOLUTION="$resolution" BLOCKED_REASON="$blocked_reason" ASSIGNEE="$assignee" DEADLINE="$deadline" python3 -c '
import json, os, sys
key, title, status, priority, parent, knowledge, tags, refs = sys.argv[1:9]
split = lambda s: [x.strip() for x in s.split(",") if x.strip()]
p = {
    "key": key, "title": title, "body": os.environ["BODY"], "status": status,
    "priority": priority, "blocked_reason": os.environ["BLOCKED_REASON"],
    "assignee": os.environ["ASSIGNEE"], "parent_task": parent,
    "knowledge": split(knowledge), "resolution": os.environ["RESOLUTION"],
    **({"tags": split(tags)} if sys.argv[-1] == "1" else {}), "refs": split(refs),
}
p.update(json.loads(os.environ["DEADLINE"]))
print(json.dumps(p))' "$key" "$title" "$status" "$priority" "$parent" "$knowledge" "$tags" "$refs" "$tags_set")"
    kyb_curl -X POST "$BASE/tasks" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  task-status)
    key="${1:-}"; [ -n "$key" ] || usage; shift || true
    status=""; assignee=""; parent=""; blocked_reason=""
    assignee_set=""; parent_set=""; reason_set=""
    dl_reset
    while [ $# -gt 0 ]; do
      case "$1" in
        --due) dl_due="$2"; dl_due_set=1; shift 2 ;;
        --hard) dl_hard="true"; shift ;;
        --no-hard) dl_hard="false"; shift ;;
        --remind-days) dl_remind="$2"; dl_remind_set=1; shift 2 ;;
        --waits-on) dl_waits="$2"; dl_waits_set=1; shift 2 ;;
        --expected) dl_expected="$2"; dl_expected_set=1; shift 2 ;;
        --status) status="$2"; shift 2 ;;
        --assignee) assignee="$2"; assignee_set="1"; shift 2 ;;
        --parent|--parent-task) parent="$2"; parent_set="1"; shift 2 ;;
        --blocked-reason) blocked_reason="$2"; reason_set="1"; shift 2 ;;
        *) die "task-status: unknown flag $1" ;;
      esac
    done
    deadline="$(deadline_json)"
    [ -n "$status$assignee_set$parent_set$reason_set" ] || [ "$deadline" != "{}" ] \
      || die "task-status: pass --status open|in_progress|blocked, or what to move (--due, --assignee, ...); close with: kyb done $key"
    require_deadlines_if_set
    # only the flags actually passed go into the payload: everything else the
    # task already says — title, body, tags, priority, links, status — stays as stored
    payload="$(STATUS="$status" ASSIGNEE="$assignee" ASSIGNEE_SET="$assignee_set" \
      PARENT="$parent" PARENT_SET="$parent_set" DEADLINE="$deadline" \
      REASON="$blocked_reason" REASON_SET="$reason_set" python3 -c '
import json, os
p = json.loads(os.environ["DEADLINE"])
if os.environ["STATUS"]:
    p["status"] = os.environ["STATUS"]
if os.environ["ASSIGNEE_SET"]:
    p["assignee"] = os.environ["ASSIGNEE"]
if os.environ["PARENT_SET"]:
    p["parent_task"] = os.environ["PARENT"]
if os.environ["REASON_SET"]:
    p["blocked_reason"] = os.environ["REASON"]
print(json.dumps(p))')"
    kyb_curl -X POST "$BASE/tasks/$key/transition" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  tasks)
    status=""; priority=""; assignee=""; parent=""; followups=""; all=""; limit="50"
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status="$2"; shift 2 ;;
        --priority) priority="$2"; shift 2 ;;
        --assignee) assignee="$2"; shift 2 ;;
        --parent|--parent-task) parent="$2"; shift 2 ;;
        --open-followups) followups="open"; shift ;;
        --all) all="true"; shift ;;
        --limit) limit="$2"; shift 2 ;;
