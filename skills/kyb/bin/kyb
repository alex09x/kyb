#!/usr/bin/env bash
# kyb — CLI for Know Your Business: our shared infrastructure knowledge base.
# The service runs in docker on the shared server; every agent and machine sees the same data.
set -euo pipefail

# Server address, in priority order: env KYB_HOST/KYB_ADDR -> the host file
# written by the installer (~/.config/kyb/host) -> localhost.
KYB_HOST="${KYB_HOST:-$(cat "$HOME/.config/kyb/host" 2>/dev/null || true)}"
KYB_HOST="${KYB_HOST:-127.0.0.1}"
ADDR="${KYB_ADDR:-$KYB_HOST:9310}"
BASE="http://$ADDR"

die() { echo "kyb: $*" >&2; exit 1; }

pretty() { if command -v jq >/dev/null 2>&1; then jq .; else cat; fi; }

urlenc() { python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${1:-}"; }

# This is a pure HTTP client for the kyb server — no ssh, no attempts to
# start or fix anything remotely. If the server doesn't answer, say so and stop.
kyb_curl() {
  local out rc=0
  out="$(curl -sS -m 15 "$@" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || die "cannot reach $ADDR: $out"
  printf '%s\n' "$out"
}

usage() {
  local status="${1:-1}"
  cat >&2 <<'EOF'
kyb — Know Your Business (our infrastructure knowledge base)
  kyb query "text" [--tag a,b] [--history] [--recent] [--limit N]
            [--kind knowledge|incident] [--status S] [--service X]
  kyb tags                                          (which topics the base covers)
  kyb add --key <slug> --title "..." [--tags a,b] [--refs r1,r2]   (body on stdin)
  kyb get <key> [--at <sha>]
  kyb history <key>
  kyb rm <key>
  kyb reindex
  kyb health

incident reports (key must start with inc-, e.g. inc-2026-07-22-orders-api-oom):
  kyb incident --template                       (print the body skeleton to fill in)
  kyb incident --key inc-<date>-<slug> --title "..." --service <svc> --severity low|medium|high|critical
               [--hosts a,b] [--status open|mitigated|resolved] [--knowledge key1,key2]
               [--detection "cmd + expected healthy result"]
               [--affected '[{"scope":"okx","from":"...Z","to":"...Z"}]']   (JSON array)
               [--started <rfc3339>] [--detected <rfc3339>]
               [--resolution "..."] [--tags a,b] [--refs r1,r2]    (body on stdin)
  kyb incidents [--status S] [--service X] [--open-followups] [--all] [--limit N]
               (live reports only, open first, freshest on top; --all adds archived closed ones,
                an explicit --status also looks into the archive)
  kyb resolve <key> [--status mitigated] [--resolution "how it ended"]
               (no --resolution: the closing comment is read from stdin)

tasks and ideas (key must start with task-, e.g. task-raise-log-retention):
  kyb task --key task-<slug> --title "..." [--status open|in_progress|blocked|done|dropped]
           [--priority low|medium|high|critical] [--blocked-reason "what it waits on"]
           [--knowledge key1,key2] [--resolution "..."] [--tags a,b] [--refs r1,r2]   (body on stdin)
           (--blocked-reason only with --status blocked; done/dropped close and archive)
  kyb tasks [--status S] [--priority P] [--open-followups] [--all] [--limit N]
           (live tasks only — open, in_progress, blocked — freshest on top;
            --all adds archived closed ones)
  kyb done <key> [--status dropped] [--resolution "what came of it"]
           (no --resolution: the closing comment is read from stdin)

Closing an incident or a task archives it: the file leaves the canon, the
report stays searchable (kyb query) and readable (kyb get) forever.
EOF
  exit "$status"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  --help|-h)
    usage 0
    ;;
  query|q)
    text="${1:-}"; [ $# -gt 0 ] && shift || true
    tag=""; history="false"; limit="10"; sort=""; kind=""; status=""; service=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --tag|--tags) tag="$2"; shift 2 ;;
        --history) history="true"; shift ;;
        --limit) limit="$2"; shift 2 ;;
        --recent) sort="recent"; shift ;;
        --kind) kind="$2"; shift 2 ;;
        --status) status="$2"; shift 2 ;;
        --service) service="$2"; shift 2 ;;
        *) die "query: unknown flag $1" ;;
      esac
    done
    kyb_curl "$BASE/search?q=$(urlenc "$text")&tag=$(urlenc "$tag")&history=$history&limit=$limit&sort=$sort&kind=$(urlenc "$kind")&status=$(urlenc "$status")&service=$(urlenc "$service")" | pretty
    ;;
  tags)
    kyb_curl "$BASE/tags" | pretty
    ;;
  add)
    key=""; title=""; tags=""; refs=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --key) key="$2"; shift 2 ;;
        --title) title="$2"; shift 2 ;;
        --tags) tags="$2"; shift 2 ;;
        --refs) refs="$2"; shift 2 ;;
        *) die "add: unknown flag $1" ;;
      esac
    done
    [ -n "$key" ] && [ -n "$title" ] || die "add: --key and --title are required (body comes from stdin)"
    body="$(cat)"
    payload="$(BODY="$body" python3 -c '
import json, os, sys
key, title, tags, refs = sys.argv[1:5]
print(json.dumps({
    "key": key, "title": title, "body": os.environ["BODY"],
    "tags": [t.strip() for t in tags.split(",") if t.strip()],
    "refs": [r.strip() for r in refs.split(",") if r.strip()],
}))' "$key" "$title" "$tags" "$refs")"
    kyb_curl -X POST "$BASE/knowledge" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  incident)
    if [ "${1:-}" = "--template" ]; then
      cat <<'TPL'
# The skeleton of a proper incident report. Each section answers "what can the
# next agent DO". Fill it, then file with:
#
#   kyb incident --key inc-$(date -u +%F)-<slug> --title "<symptom, not diagnosis>" \
#     --service <svc> --hosts <h1,h2> --severity low|medium|high|critical \
#     --detection "<command/SQL + expected healthy result>" \
#     --affected '[{"scope":"<exchange/table/host>","from":"<UTC>","to":"<UTC>"}]' \
#     --knowledge <arch-entry,host-entry> --tags <a,b> <<'EOF' ... EOF
#
# (--started/--detected RFC3339 if known; mitigated/resolved are stamped by the server)

Symptom: <what it LOOKS like, verbatim — "heatmap shows +38,000,000%". The search anchor.>

Impact: <what is broken for whom; exact poisoned windows go to --affected, not prose>

Root cause (verified|suspected|unknown): <mark the confidence honestly>

Cure / runbook:
  1. <step>                      # SAFE — agent may do this alone
  2. <verify: detection returns to healthy>
  3. <step>                      # APPROVAL — only with a human

Actions log:
  <UTC time> | <action> | <verification right after it — an action without one = not done>

Follow-ups:
- [ ] <loose end; the server counts these — kyb incidents --open-followups>
TPL
      exit 0
    fi
    key=""; title=""; service=""; hosts=""; severity=""; status="open"
    knowledge=""; resolution=""; detection=""; affected=""; started=""; detected=""; tags=""; refs=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --key) key="$2"; shift 2 ;;
        --title) title="$2"; shift 2 ;;
        --service) service="$2"; shift 2 ;;
        --hosts) hosts="$2"; shift 2 ;;
        --severity) severity="$2"; shift 2 ;;
        --status) status="$2"; shift 2 ;;
        --knowledge) knowledge="$2"; shift 2 ;;
        --resolution) resolution="$2"; shift 2 ;;
        --detection) detection="$2"; shift 2 ;;
        --affected) affected="$2"; shift 2 ;;
        --started) started="$2"; shift 2 ;;
        --detected) detected="$2"; shift 2 ;;
        --tags) tags="$2"; shift 2 ;;
        --refs) refs="$2"; shift 2 ;;
        *) die "incident: unknown flag $1" ;;
      esac
    done
    [ -n "$key" ] && [ -n "$title" ] && [ -n "$service" ] && [ -n "$severity" ] \
      || die "incident: --key, --title, --service and --severity are required (body comes from stdin)"
    body="$(cat)"
    payload="$(BODY="$body" RESOLUTION="$resolution" DETECTION="$detection" AFFECTED="$affected" python3 -c '
import json, os, sys
key, title, service, hosts, severity, status, knowledge, started, detected, tags, refs = sys.argv[1:12]
split = lambda s: [x.strip() for x in s.split(",") if x.strip()]
affected = os.environ["AFFECTED"].strip()
try:
    affected = json.loads(affected) if affected else []
except json.JSONDecodeError as e:
    sys.exit(f"kyb: --affected is not valid JSON ({e}); expected: [{{\"scope\":...,\"from\":...,\"to\":...}}]")
print(json.dumps({
    "key": key, "title": title, "body": os.environ["BODY"],
    "service": service, "hosts": split(hosts), "severity": severity, "status": status,
    "knowledge": split(knowledge), "resolution": os.environ["RESOLUTION"],
    "detection": os.environ["DETECTION"], "affected": affected,
    "started_at": started, "detected_at": detected,
    "tags": split(tags), "refs": split(refs),
}))' "$key" "$title" "$service" "$hosts" "$severity" "$status" "$knowledge" "$started" "$detected" "$tags" "$refs")"
    kyb_curl -X POST "$BASE/incidents" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  incidents)
    status=""; service=""; followups=""; all=""; limit="50"
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status="$2"; shift 2 ;;
        --service) service="$2"; shift 2 ;;
        --open-followups) followups="open"; shift ;;
        --all) all="true"; shift ;;
        --limit) limit="$2"; shift 2 ;;
        *) die "incidents: unknown flag $1" ;;
      esac
    done
    kyb_curl "$BASE/incidents?status=$(urlenc "$status")&service=$(urlenc "$service")&followups=$followups&all=$all&limit=$limit" | pretty
    ;;
  resolve)
    key="${1:-}"; [ -n "$key" ] || usage; shift || true
    status="resolved"; resolution=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status="$2"; shift 2 ;;
        --resolution) resolution="$2"; shift 2 ;;
        *) die "resolve: unknown flag $1" ;;
      esac
    done
    # no --resolution: read the closing comment from stdin (required to close)
    if [ -z "$resolution" ] && ! [ -t 0 ]; then resolution="$(cat)"; fi
    payload="$(RESOLUTION="$resolution" python3 -c '
import json, os, sys
print(json.dumps({"status": sys.argv[1], "resolution": os.environ["RESOLUTION"]}))' "$status")"
    kyb_curl -X POST "$BASE/incidents/$key/resolve" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  task)
    key=""; title=""; status="open"; priority=""; blocked_reason=""
    knowledge=""; resolution=""; tags=""; refs=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --key) key="$2"; shift 2 ;;
        --title) title="$2"; shift 2 ;;
        --status) status="$2"; shift 2 ;;
        --priority) priority="$2"; shift 2 ;;
        --blocked-reason) blocked_reason="$2"; shift 2 ;;
        --knowledge) knowledge="$2"; shift 2 ;;
        --resolution) resolution="$2"; shift 2 ;;
        --tags) tags="$2"; shift 2 ;;
        --refs) refs="$2"; shift 2 ;;
        *) die "task: unknown flag $1" ;;
      esac
    done
    [ -n "$key" ] && [ -n "$title" ] || die "task: --key and --title are required (body comes from stdin)"
    body="$(cat)"
    payload="$(BODY="$body" RESOLUTION="$resolution" BLOCKED_REASON="$blocked_reason" python3 -c '
import json, os, sys
key, title, status, priority, knowledge, tags, refs = sys.argv[1:8]
split = lambda s: [x.strip() for x in s.split(",") if x.strip()]
print(json.dumps({
    "key": key, "title": title, "body": os.environ["BODY"], "status": status,
    "priority": priority, "blocked_reason": os.environ["BLOCKED_REASON"],
    "knowledge": split(knowledge), "resolution": os.environ["RESOLUTION"],
    "tags": split(tags), "refs": split(refs),
}))' "$key" "$title" "$status" "$priority" "$knowledge" "$tags" "$refs")"
    kyb_curl -X POST "$BASE/tasks" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  tasks)
    status=""; priority=""; followups=""; all=""; limit="50"
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status="$2"; shift 2 ;;
        --priority) priority="$2"; shift 2 ;;
        --open-followups) followups="open"; shift ;;
        --all) all="true"; shift ;;
        --limit) limit="$2"; shift 2 ;;
        *) die "tasks: unknown flag $1" ;;
      esac
    done
    kyb_curl "$BASE/tasks?status=$(urlenc "$status")&priority=$(urlenc "$priority")&followups=$followups&all=$all&limit=$limit" | pretty
    ;;
  done)
    key="${1:-}"; [ -n "$key" ] || usage; shift || true
    status="done"; resolution=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status="$2"; shift 2 ;;
        --resolution) resolution="$2"; shift 2 ;;
        *) die "done: unknown flag $1" ;;
      esac
    done
    # no --resolution: read the closing comment from stdin (required to close)
    if [ -z "$resolution" ] && ! [ -t 0 ]; then resolution="$(cat)"; fi
    payload="$(RESOLUTION="$resolution" python3 -c '
import json, os, sys
print(json.dumps({"status": sys.argv[1], "resolution": os.environ["RESOLUTION"]}))' "$status")"
    kyb_curl -X POST "$BASE/tasks/$key/resolve" -H 'content-type: application/json' -d "$payload" | pretty
    ;;
  get)
    key="${1:-}"; [ -n "$key" ] || usage; shift || true
    at=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --at) at="$2"; shift 2 ;;
        *) die "get: unknown flag $1" ;;
      esac
    done
    q=""; [ -n "$at" ] && q="?at=$(urlenc "$at")"
    kyb_curl "$BASE/knowledge/$key$q" | pretty
    ;;
  history)
    key="${1:-}"; [ -n "$key" ] || usage
    kyb_curl "$BASE/knowledge/$key/history" | pretty
    ;;
  rm|delete)
    key="${1:-}"; [ -n "$key" ] || usage
    kyb_curl -X DELETE "$BASE/knowledge/$key" | pretty
    ;;
  reindex)
    kyb_curl -X POST "$BASE/reindex" | pretty
    ;;
  health)
    kyb_curl "$BASE/healthz" | pretty
    ;;
  *)
    usage
    ;;
esac
