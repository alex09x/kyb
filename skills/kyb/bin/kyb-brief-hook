#!/usr/bin/env python3
# KYB (Know Your Business) — git-backed knowledge base and incident tracker for AI agent fleets
# Copyright (c) 2026 Alexander Panasenko
#
# Contact: alex@prod.codes
# Author: https://prod.codes/about/
# Project: https://github.com/alex09x/kyb
# SPDX-License-Identifier: MIT
#
# A Claude Code SessionStart hook: puts `kyb brief` (open incidents, active work,
# deadlines, recently retracted and changed knowledge, as pointers) into the
# session's context, so an agent learns what is live even when it never thinks
# to query.
#
# It fails silent. If the server is down, slow, or too old to have a brief, the
# hook prints nothing and exits 0: a KYB outage must never block or slow a
# session start. KYB_BRIEF=0 in the environment switches it off.
#
# Registered by skills/install.sh in ~/.claude/settings.json under SessionStart
# (skip with `install.sh --no-brief`). KYB_BRIEF_ARGS adds flags, e.g. "--tag edge".
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys

TIMEOUT_SECONDS = float(os.environ.get("KYB_BRIEF_TIMEOUT") or 3)


def kyb_cli():
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "kyb")
    return here if os.access(here, os.X_OK) else shutil.which("kyb")


def main():
    if os.environ.get("KYB_BRIEF", "1").strip().lower() in ("0", "false", "no", "off"):
        return
    try:
        sys.stdin.read()  # the event; nothing in it changes the brief
    except (OSError, ValueError):
        pass
    cli = kyb_cli()
    if not cli:
        return
    try:
        extra = shlex.split(os.environ.get("KYB_BRIEF_ARGS", ""))
        # its own process group: on a timeout the whole group goes, curl included,
        # or a grandchild still holding the pipe would keep us waiting for it
        proc = subprocess.Popen(
            [cli, "brief", *extra],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, start_new_session=True,
        )
    except (OSError, ValueError):
        return
    try:
        out, _ = proc.communicate(timeout=TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        return
    text = (out or "").strip()
    if proc.returncode != 0 or not text:
        return
    json.dump({
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": text,
        }
    }, sys.stdout)


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 - whatever went wrong, the session starts
        pass
    sys.exit(0)
